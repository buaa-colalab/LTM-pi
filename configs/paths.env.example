# This is a public template. bin/setup.sh replaces the placeholder below with
# the selected resource directory and writes the result to the git-ignored .env.
ROBOMME_RESOURCE_ROOT=/absolute/path/to/ltm_pi_robomme-resources

# Required paths derived from the resource root.
PI05_BASE_PARAMS=${ROBOMME_RESOURCE_ROOT}/models/pi05/params
DREAMDOJO_CHECKPOINT=${ROBOMME_RESOURCE_ROOT}/models/dreamdojo/LAM_400k.ckpt

ROBOMME_VIDEO_DATASET=${ROBOMME_RESOURCE_ROOT}/datasets/video
ROBOMME_MEMORY_CACHE=${ROBOMME_RESOURCE_ROOT}/artifacts/memory
ROBOMME_ANCHOR_CACHE=${ROBOMME_RESOURCE_ROOT}/artifacts/anchors
ROBOMME_ASSETS_ROOT=${ROBOMME_RESOURCE_ROOT}/assets
ROBOMME_ASSET_ID=lerobot/robomme_16x1000
HF_CACHE=${ROBOMME_RESOURCE_ROOT}/cache/huggingface
